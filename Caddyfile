{
	servers {
		# tuna и docker-сеть — частные адреса: доверяем их X-Forwarded-For, чтобы до app дошёл реальный IP клиента
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS} {
	encode gzip

	# API и загруженные файлы — Nest
	handle /api/* {
		reverse_proxy app:4200
	}

	handle /uploads/* {
		reverse_proxy app:4200
	}

	# Всё остальное (сайт и SPA на /app) — Next
	handle {
		reverse_proxy web:3000
	}
}
