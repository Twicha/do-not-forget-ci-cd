# Postgres (контейнер postgres в docker-compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=do_not_forget

# Backend
TELEGRAM_GATEWAY_TOKEN=

# Авторизация
# Ключи подписи access-токенов: "kid:секрет", через запятую. Первый — активный, остальные только проверяются.
# Секрет: openssl rand -base64 48
# Смена ключа без разлогина: новый ключ ставим первым, старый удаляем через 10 минут.
JWT_ACCESS_KEYS=
# Необязательно: JWT_ISSUER=do-not-forget, JWT_AUDIENCE=do-not-forget-web
# Адреса, с которых фронт шлёт запросы (Origin), через запятую. На сервере — https://<домен>
APP_ORIGINS=
# false — только для разработки по http с другого устройства (Secure-cookie там не ставятся)
# AUTH_COOKIE_SECURE=false
# ВРЕМЕННО: вход по паролю. Хеш пароля:
# node -e "require('argon2').hash(process.argv[1]).then(console.log)" 'пароль'   (из папки backend)
PASSWORD_LOGIN_ENABLED=false
MOCK_ACCOUNTS='[{"phone":"+79990000001","hash":"$argon2id$..."}]'

# Адрес сайта для Caddy. Локально не задавать (будет http://localhost),
# на сервере — домен, например: SITE_ADDRESS=example.ru
# SITE_ADDRESS=

# Полный адрес сайта для sitemap.xml (сервис web), например: SITE_URL=https://example.ru
# SITE_URL=
